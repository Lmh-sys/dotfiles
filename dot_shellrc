# ─── Shared shell config (bash + zsh) ────────────────────────────────
# Sourced by ~/.bashrc and ~/.zshrc. Keep this POSIX-ish / dual-shell safe.
# Zsh-only features (plugins, setopt, bindkey) stay in ~/.zshrc.

# Guard: only once per shell session
[ -n "${_SHELLRC_LOADED:-}" ] && return 0
_SHELLRC_LOADED=1

# Detect shell for init hooks
if [ -n "${ZSH_VERSION:-}" ]; then
    _SHELLRC_SHELL=zsh
elif [ -n "${BASH_VERSION:-}" ]; then
    _SHELLRC_SHELL=bash
else
    _SHELLRC_SHELL=sh
fi

# ─── PATH ────────────────────────────────────────────────────────────
# Prefer user-local bins
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# Homebrew (macOS)
if [ -d /opt/homebrew/bin ]; then
    case ":$PATH:" in
        *":/opt/homebrew/bin:"*) ;;
        *) export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH" ;;
    esac
elif [ -d /usr/local/Cellar ]; then
    case ":$PATH:" in
        *":/usr/local/bin:"*) ;;
        *) export PATH="/usr/local/bin:/usr/local/sbin:$PATH" ;;
    esac
fi

# fnm binary path (Linux installer default)
if [ -d "$HOME/.local/share/fnm" ]; then
    case ":$PATH:" in
        *":$HOME/.local/share/fnm:"*) ;;
        *) export PATH="$HOME/.local/share/fnm:$PATH" ;;
    esac
fi

# ─── Starship prompt ────────────────────────────────────────────────
if command -v starship >/dev/null 2>&1 && [ "$_SHELLRC_SHELL" != sh ]; then
    eval "$(starship init "$_SHELLRC_SHELL")"
fi

# ─── fzf ─────────────────────────────────────────────────────────────
if [ "$_SHELLRC_SHELL" = zsh ]; then
    if [ -f "$HOME/.fzf.zsh" ]; then
        # shellcheck source=/dev/null
        . "$HOME/.fzf.zsh"
    elif command -v fzf >/dev/null 2>&1; then
        eval "$(fzf --zsh 2>/dev/null)"
    fi
elif [ "$_SHELLRC_SHELL" = bash ]; then
    if [ -f "$HOME/.fzf.bash" ]; then
        # shellcheck source=/dev/null
        . "$HOME/.fzf.bash"
    elif command -v fzf >/dev/null 2>&1; then
        eval "$(fzf --bash 2>/dev/null)"
    fi
fi

export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'
if command -v fd >/dev/null 2>&1; then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
fi

# ─── Zoxide (smart cd) ──────────────────────────────────────────────
if command -v zoxide >/dev/null 2>&1 && [ "$_SHELLRC_SHELL" != sh ]; then
    eval "$(zoxide init "$_SHELLRC_SHELL")"
fi

# ─── fnm (Node version manager) ─────────────────────────────────────
if command -v fnm >/dev/null 2>&1 && [ "$_SHELLRC_SHELL" != sh ]; then
    eval "$(fnm env --use-on-cd --shell "$_SHELLRC_SHELL")"
fi

# ─── SSH key switcher (fallback for multi-account setups) ────────────
# Usage: set-ssh-key lewis-official-20260224
set-ssh-key() {
    local key="$HOME/.ssh/$1"
    if [ ! -f "$key" ]; then
        echo "Key not found: $key" >&2
        echo "Available keys:" >&2
        # shellcheck disable=SC2012
        ls ~/.ssh/*.pub 2>/dev/null | sed 's/.*\//  /; s/\.pub$//' >&2
        return 1
    fi
    ssh-add -D 2>/dev/null
    ssh-add "$key"
    echo "Active SSH key: $1"
}

# ─── Aliases (modern CLI tools) ──────────────────────────────────────
# Only bind when the tool exists, so bare systems stay usable.
command -v eza >/dev/null 2>&1 && {
    alias ls='eza --icons --group-directories-first'
    alias ll='eza -la --icons --group-directories-first'
    alias lt='eza --tree --icons --level=2'
}
command -v bat >/dev/null 2>&1 && alias cat='bat'
command -v fd >/dev/null 2>&1 && alias find='fd'
command -v rg >/dev/null 2>&1 && alias grep='rg'
command -v btop >/dev/null 2>&1 && alias top='btop'
command -v lazygit >/dev/null 2>&1 && alias lg='lazygit'

# ─── pnpm ────────────────────────────────────────────────────────────
if [ -d "$HOME/.local/share/pnpm" ]; then
    export PNPM_HOME="$HOME/.local/share/pnpm"
elif [ -d "$HOME/Library/pnpm" ]; then
    export PNPM_HOME="$HOME/Library/pnpm"
fi
if [ -n "${PNPM_HOME:-}" ]; then
    case ":$PATH:" in
        *":$PNPM_HOME:"*) ;;
        *) export PATH="$PNPM_HOME:$PATH" ;;
    esac
fi

# ─── User aliases ────────────────────────────────────────────────────
alias sudo='sudo '
command -v gnome-text-editor >/dev/null 2>&1 && alias gedit='gnome-text-editor'

# ─── fishros ─────────────────────────────────────────────────────────
if [ -d "$HOME/.fishros/bin" ]; then
    case ":$PATH:" in
        *":$HOME/.fishros/bin:"*) ;;
        *) export PATH="$PATH:$HOME/.fishros/bin" ;;
    esac
fi

# ─── ROS (shell-aware setup scripts) ─────────────────────────────────
# Prefer setup.$shell, fall back to setup.sh
_shellrc_source_ros() {
    # $1 = setup dir containing setup.bash / setup.zsh / setup.sh
    local dir="$1"
    [ -d "$dir" ] || return 0
    case "$_SHELLRC_SHELL" in
        zsh)
            if [ -f "$dir/setup.zsh" ]; then
                # shellcheck source=/dev/null
                . "$dir/setup.zsh"
            elif [ -f "$dir/setup.sh" ]; then
                # shellcheck source=/dev/null
                . "$dir/setup.sh"
            fi
            ;;
        bash)
            if [ -f "$dir/setup.bash" ]; then
                # shellcheck source=/dev/null
                . "$dir/setup.bash"
            elif [ -f "$dir/setup.sh" ]; then
                # shellcheck source=/dev/null
                . "$dir/setup.sh"
            fi
            ;;
        *)
            [ -f "$dir/setup.sh" ] && . "$dir/setup.sh"
            ;;
    esac
}

# system ROS distro (path exists → source)
_shellrc_source_ros /opt/ros/jazzy

# ─── ROS2 / Colcon zsh completions ───────────────────────────────
if [[ -n "$ZSH_VERSION" ]]; then
    eval "$(register-python-argcomplete --shell zsh ros2)"
    eval "$(register-python-argcomplete --shell zsh colcon 2>/dev/null || true)"
fi

export RMW_IMPLEMENTATION="${RMW_IMPLEMENTATION:-rmw_cyclonedds_cpp}"
export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-99}"

# workspace overlay
_shellrc_source_ros "$HOME/code/jazzy/rely_ws/install"

# ─── Local Xwayland display (SSH → desktop GUI) ──────────────────────
use_local_display() {
    local auth
    auth="$(ls -1t /run/user/"$(id -u)"/.mutter-Xwaylandauth.* 2>/dev/null | head -n1 || true)"
    if [ -n "$auth" ] && [ -r "$auth" ] && [ -S /tmp/.X11-unix/X0 ]; then
        export DISPLAY="${DISPLAY:-:0}"
        [ "$DISPLAY" = ":0.0" ] && export DISPLAY=:0
        export XAUTHORITY="$auth"
        return 0
    fi
    echo "local Xwayland display/auth not found" >&2
    return 1
}

# SSH sessions: bind to local desktop so rviz2/xclock can show
if [ -n "${SSH_CONNECTION:-}" ]; then
    use_local_display >/dev/null 2>&1 || true
fi

# ─── nvm (optional; may coexist with fnm) ────────────────────────────
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
    # shellcheck source=/dev/null
    . "$NVM_DIR/nvm.sh"
fi
# bash completion only
if [ "$_SHELLRC_SHELL" = bash ] && [ -s "$NVM_DIR/bash_completion" ]; then
    # shellcheck source=/dev/null
    . "$NVM_DIR/bash_completion"
fi

unset -f _shellrc_source_ros 2>/dev/null || true
unset _SHELLRC_SHELL
