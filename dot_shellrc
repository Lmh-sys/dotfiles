# ─── 本地 Xwayland 显示器（SSH → 桌面 GUI）────────────────────────
use_local_display() {
    local auth
    # 查找最新的 Mutter Xwayland 认证文件
    auth="$(ls -1t /run/user/"$(id -u)"/.mutter-Xwaylandauth.* 2>/dev/null | head -n1 || true)"
    if [ -n "$auth" ] && [ -r "$auth" ] && [ -S /tmp/.X11-unix/X0 ]; then
        # 设置显示器编号，默认 :0
        export DISPLAY="${DISPLAY:-:0}"
        [ "$DISPLAY" = ":0.0" ] && export DISPLAY=:0
        # 设置 X 认证文件路径
        export XAUTHORITY="$auth"
        return 0
    fi
    echo "未找到本地 Xwayland 显示器/认证文件" >&2
    return 1
}

# SSH 会话：绑定到本地桌面，使 rviz2/xclock 等能正常显示
if [ -n "${SSH_CONNECTION:-}" ]; then
    use_local_display >/dev/null 2>&1 || true
fi

# ─── nvm（可选；可与 fnm 共存）────────────────────────────────────
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
    # shellcheck source=/dev/null
    . "$NVM_DIR/nvm.sh"
