# ─── 共享 Shell 配置（bash + zsh）────────────────────────────────
# 被 ~/.bashrc 和 ~/.zshrc 引用。请保持 POSIX 风格 / 双 Shell 兼容。
# Zsh 专属功能（插件、setopt、bindkey）请放在 ~/.zshrc 中。

# 守卫：每个 Shell 会话仅加载一次
[ -n "${_SHELLRC_LOADED:-}" ] && return 0
_SHELLRC_LOADED=1

# 检测当前 Shell，用于后续初始化钩子
if [ -n "${ZSH_VERSION:-}" ]; then
    _SHELLRC_SHELL=zsh
elif [ -n "${BASH_VERSION:-}" ]; then
    _SHELLRC_SHELL=bash
else
    _SHELLRC_SHELL=sh
fi

# ─── PATH ────────────────────────────────────────────────────────────
# 优先使用用户本地 bin
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# Homebrew（macOS）
if [ -d /opt/homebrew/bin ]; then
    case ":$PATH:" in
        *":/opt/homebrew/bin:"*) ;;
        *) export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH" ;;
    esac
elif [ -d /usr/local/Cellar ]; then
    case ":$PATH:" in
        *":/usr/local/bin:"*) ;;
        *) export PATH="/usr/local/bin:/usr/local/sbin:$PATH" ;;
    esac
fi

# fnm 二进制路径（Linux 安装器默认路径）
if [ -d "$HOME/.local/share/fnm" ]; then
    case ":$PATH:" in
        *":$HOME/.local/share/fnm:"*) ;;
        *) export PATH="$HOME/.local/share/fnm:$PATH" ;;
    esac
fi

# ─── Starship 提示符 ────────────────────────────────────────────────
if command -v starship >/dev/null 2>&1 && [ "$_SHELLRC_SHELL" != sh ]; then
    eval "$(starship init "$_SHELLRC_SHELL")"
fi

# ─── Atuin（历史搜索：Ctrl+R 取代 fzf）─────────────────────────────
# 二进制装在 ~/.atuin/bin（cargo-dist 安装器），installer 的 env 脚本只补 PATH。
# zsh 的 Ctrl+R 绑定会被 OMZ 覆盖，所以 zsh 侧在 ~/.zshrc 载入 OMZ 之后再 init；
# 这里只负责 bash，且仅在交互式 shell 里生效（避免 bash -lc 也跑一遍）。
[ -f "$HOME/.atuin/bin/env" ] && . "$HOME/.atuin/bin/env"
if [ "$_SHELLRC_SHELL" = bash ] && [ -n "${PS1:-}" ] && command -v atuin >/dev/null 2>&1; then
    eval "$(atuin init bash --disable-up-arrow --disable-ai)"
fi

# ─── Zoxide（智能 cd）──────────────────────────────────────────────
if command -v zoxide >/dev/null 2>&1 && [ "$_SHELLRC_SHELL" != sh ]; then
    eval "$(zoxide init "$_SHELLRC_SHELL")"
fi

# ─── fnm（Node 版本管理器）─────────────────────────────────────────
if command -v fnm >/dev/null 2>&1 && [ "$_SHELLRC_SHELL" != sh ]; then
    eval "$(fnm env --use-on-cd --shell "$_SHELLRC_SHELL")"
fi

# ─── SSH 密钥切换器（多账号场景备用方案）────────────────────────
# 用法：set-ssh-key lewis-official-20260224
set-ssh-key() {
    local key="$HOME/.ssh/$1"
    if [ ! -f "$key" ]; then
        echo "Key not found: $key" >&2
        echo "Available keys:" >&2
        # shellcheck disable=SC2012
        ls ~/.ssh/*.pub 2>/dev/null | sed 's/.*\//  /; s/\.pub$//' >&2
        return 1
    fi
    ssh-add -D 2>/dev/null
    ssh-add "$key"
    echo "Active SSH key: $1"
}

# ─── 别名（现代 CLI 工具）─────────────────────────────────────────
# 仅当工具存在时才绑定别名，确保裸系统仍可使用。
# lsd 别名（现代 ls 替代）。zsh 的 OMZ 会用 GNU ls 覆盖 ls/ll，
# 所以抽成函数，~/.zshrc 在载入 OMZ 之后再调用一次。
lsd_aliases() {
    command -v lsd >/dev/null 2>&1 || return 0
    alias ls='lsd --icon auto --group-directories-first'
    alias ll='lsd -la --icon auto --group-directories-first'
    alias lt='lsd --tree --icon auto --depth=2'
}
lsd_aliases
command -v bat >/dev/null 2>&1 && alias cat='bat'
command -v fd >/dev/null 2>&1 && alias find='fd'
# 不要把 grep 替换成 rg：系统脚本常用 grep 的短参数（例如 -Eq），
# 而 rg 对这些参数的含义不同，会导致配置脚本误报。
command -v rg >/dev/null 2>&1 && alias rgrep='rg'
command -v btop >/dev/null 2>&1 && alias top='btop'
command -v lazygit >/dev/null 2>&1 && alias lg='lazygit'

# ─── pnpm ────────────────────────────────────────────────────────────
if [ -d "$HOME/.local/share/pnpm" ]; then
    export PNPM_HOME="$HOME/.local/share/pnpm"
elif [ -d "$HOME/Library/pnpm" ]; then
    export PNPM_HOME="$HOME/Library/pnpm"
fi
if [ -n "${PNPM_HOME:-}" ]; then
    case ":$PATH:" in
        *":$PNPM_HOME:"*) ;;
        *) export PATH="$PNPM_HOME:$PATH" ;;
    esac
fi

# ─── 用户自定义别名 ──────────────────────────────────────────────────
alias sudo='sudo '
command -v gnome-text-editor >/dev/null 2>&1 && alias gedit='gnome-text-editor'

# ─── fishros ─────────────────────────────────────────────────────────
if [ -d "$HOME/.fishros/bin" ]; then
    case ":$PATH:" in
        *":$HOME/.fishros/bin:"*) ;;
        *) export PATH="$PATH:$HOME/.fishros/bin" ;;
    esac
fi

# ─── ROS（根据 Shell 类型加载配置脚本）─────────────────────────────
# 优先加载 setup.$shell，回退到 setup.sh
_shellrc_source_ros() {
    # $1 = 包含 setup.bash / setup.zsh / setup.sh 的目录
    local dir="$1"
    [ -d "$dir" ] || return 0
    case "$_SHELLRC_SHELL" in
        zsh)
            if [ -f "$dir/setup.zsh" ]; then
                # shellcheck source=/dev/null
                . "$dir/setup.zsh"
            elif [ -f "$dir/setup.sh" ]; then
                # shellcheck source=/dev/null
                . "$dir/setup.sh"
            fi
            ;;
        bash)
            if [ -f "$dir/setup.bash" ]; then
                # shellcheck source=/dev/null
                . "$dir/setup.bash"
            elif [ -f "$dir/setup.sh" ]; then
                # shellcheck source=/dev/null
                . "$dir/setup.sh"
            fi
            ;;
        *)
            [ -f "$dir/setup.sh" ] && . "$dir/setup.sh"
            ;;
    esac
}

# 系统级 ROS 发行版（路径存在则 source）
_shellrc_source_ros /opt/ros/jazzy

# 已安装驱动的统一 ROS / DDS 环境入口；源码工作区仅在需要时手动加载。
if [ -f /opt/driver/common/config ]; then
    _shellrc_source_ros /opt/driver/install
    if [ "${CONFIG_WITH_DRIVERS:-1}" != 0 ]; then
        alias rundriver='sudo systemctl restart driver.service'
    fi
fi

# ─── 本地 Xwayland 显示器（SSH → 桌面 GUI）────────────────────────
use_local_display() {
    local auth
    # 查找最新的 Mutter Xwayland 认证文件
    auth="$(ls -1t /run/user/"$(id -u)"/.mutter-Xwaylandauth.* 2>/dev/null | head -n1 || true)"
    if [ -n "$auth" ] && [ -r "$auth" ] && [ -S /tmp/.X11-unix/X0 ]; then
        # 设置显示器编号，默认 :0
        export DISPLAY="${DISPLAY:-:0}"
        [ "$DISPLAY" = ":0.0" ] && export DISPLAY=:0
        # 设置 X 认证文件路径
        export XAUTHORITY="$auth"
        return 0
    fi
    echo "未找到本地 Xwayland 显示器/认证文件" >&2
    return 1
}

# SSH 会话：绑定到本地桌面，使 rviz2/xclock 等能正常显示
if [ -n "${SSH_CONNECTION:-}" ]; then
    use_local_display >/dev/null 2>&1 || true
fi

# ─── nvm（可选；可与 fnm 共存）────────────────────────────────────
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
    # shellcheck source=/dev/null
    . "$NVM_DIR/nvm.sh"
fi
# bash 自动补全（仅 bash 需要）
if [ "$_SHELLRC_SHELL" = bash ] && [ -s "$NVM_DIR/bash_completion" ]; then
    # shellcheck source=/dev/null
    . "$NVM_DIR/bash_completion"
fi

unset -f _shellrc_source_ros 2>/dev/null || true
unset _SHELLRC_SHELL
function y() {
	local tmp cwd; tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd" || builtin true
	command rm -f -- "$tmp"
}
